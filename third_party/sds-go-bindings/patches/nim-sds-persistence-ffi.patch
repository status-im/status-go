+proc bytesToSeq(value: string): seq[byte] =
+  result = newSeq[byte](value.len)
+  for i, ch in value:
+    result[i] = byte(ch)
+
+proc invokePersistence(
+    operation: cint, channelId: string, payload: openArray[byte]
+): Result[string, string] =
+  if sdsPersistenceCb.isNil():
+    return err("SDS persistence callback is not registered")
+
+  var response: cstring
+  var responseLen: csize_t
+  var payloadPtr: ptr byte
+  if payload.len > 0:
+    payloadPtr = unsafeAddr payload[0]
+
+  let ret = cast[SdsPersistenceCallback](sdsPersistenceCb)(
+    operation,
+    channelId.cstring,
+    payloadPtr,
+    csize_t(payload.len),
+    addr response,
+    addr responseLen,
+    sdsPersistenceUserData,
+  )
+  var responseText = ""
+  if not response.isNil() and responseLen > 0:
+    responseText = newString(int(responseLen))
+    copyMem(addr responseText[0], response, int(responseLen))
+  if not response.isNil():
+    c_free(response)
+  if ret != RET_OK:
+    return err(if responseText.len == 0: "SDS persistence callback failed" else: responseText)
+  ok(responseText)
+
+proc goPersistence(): Persistence =
+  result.saveChannelMeta = proc(
+      channelId: SdsChannelID, meta: ChannelMeta
+  ): Future[Result[void, string]] {.async: (raises: []), gcsafe.} =
+    let saved = invokePersistence(1, $channelId, encode(meta).buffer)
+    if saved.isErr():
+      return err(saved.error)
+    return ok()
+
+  result.updateHistory = proc(
+      channelId: SdsChannelID, update: HistoryUpdate
+  ): Future[Result[void, string]] {.async: (raises: []), gcsafe.} =
+    var request = newJObject()
+    var appended = newJArray()
+    for message in update.append:
+      let encoded = wire.serializeMessage(message).valueOr:
+        return err("failed to serialize SDS history message: " & $error)
+      var entry = newJObject()
+      entry["messageId"] = %* message.messageId
+      entry["lamportTimestamp"] = %* message.lamportTimestamp
+      entry["data"] = % encode(encoded)
+      appended.add(entry)
+    request["append"] = appended
+    request["evict"] = %* update.evict
+    let saved = invokePersistence(2, $channelId, bytesToSeq($request))
+    if saved.isErr():
+      return err(saved.error)
+    return ok()
+
+  result.loadChannel = proc(
+      channelId: SdsChannelID
+  ): Future[Result[ChannelData, string]] {.async: (raises: []), gcsafe.} =
+    let loaded = invokePersistence(3, $channelId, [])
+    if loaded.isErr():
+      return err(loaded.error)
+    try:
+      let data = parseJson(loaded.value)
+      var channel = ChannelData.init()
+      if data.hasKey("meta") and data["meta"].kind == JString and data["meta"].getStr().len > 0:
+        let decoded = ChannelMeta.decode(bytesToSeq(decode(data["meta"].getStr()))).valueOr:
+          return err("failed to decode persisted SDS channel metadata")
+        channel.meta = decoded
+      if data.hasKey("messageHistory") and data["messageHistory"].kind == JArray:
+        for entry in data["messageHistory"]:
+          let message = wire.deserializeMessage(bytesToSeq(decode(entry.getStr()))).valueOr:
+            return err("failed to decode persisted SDS history message")
+          channel.messageHistory.add(message)
+      return ok(channel)
+    except CatchableError as exc:
+      return err("failed to load persisted SDS channel: " & exc.msg)
+
+  result.dropChannel = proc(
+      channelId: SdsChannelID
+  ): Future[Result[void, string]] {.async: (raises: []), gcsafe.} =
+    let dropped = invokePersistence(4, $channelId, [])
+    if dropped.isErr():
+      return err(dropped.error)
+    return ok()
+
