#!/usr/bin/env groovy
library 'status-jenkins-lib@v1.9.39'

def isPRBuild = utils.isPRBuild()

pipeline {
  agent {
    docker {
      label 'linuxcontainer'
      image 'harbor.status.im/infra/ci-build-containers:linux-base-1.0.0'
      args '--volume=/nix:/nix ' +
           '--volume=/etc/nix:/etc/nix ' +
           '--volume=/var/run/docker.sock:/var/run/docker.sock ' +
           '--network=host ' +
           '--user jenkins'
    }
  }

  parameters {
    string(
      name: 'BRANCH',
      defaultValue: 'develop',
      description: 'Name of branch to build.'
    )
    booleanParam(
      name: 'FUNCTIONAL_TESTS_REPORT_CODECOV',
      defaultValue: true,
      description: 'Should the job report test coverage to Codecov?'
    )
    choice(
      name: 'FUNCTIONAL_TESTS_LOG_LEVEL',
      choices: ['DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL'],
      description: 'pytest log level'
    )
  }

  options {
    timestamps()
    /* Prevent Jenkins jobs from running forever */
    timeout(time: 50, unit: 'MINUTES')
    disableConcurrentBuilds()
    disableRestartFromStage()
    /* manage how many builds we keep */
    buildDiscarder(logRotator(
      numToKeepStr: '10',
      daysToKeepStr: isPRBuild ? '14' : '30',
      artifactNumToKeepStr: isPRBuild ? '1' : '10',
      artifactDaysToKeepStr: isPRBuild ? '7' : '30',
      removeLastBuild: isPRBuild,
    ))
  }

  environment {
    PLATFORM = 'tests-rpc'
    PKG_URL = "${currentBuild.absoluteUrl}/consoleText"

    /* Pass PR/commit/branch to codecov so uploads are associated with the PR. */
    CODECOV_SHA    = "${env.GIT_COMMIT}"
    CODECOV_BRANCH = "${params.BRANCH}"
    CODECOV_PR     = "${utils.changeId() ?: ''}"

    /* Hack-fix for params not being set in env on first job run. */
    BRANCH =                          "${params.BRANCH}"
    FUNCTIONAL_TESTS_REPORT_CODECOV = "${params.FUNCTIONAL_TESTS_REPORT_CODECOV}"
    FUNCTIONAL_TESTS_LOG_LEVEL =      "${params.FUNCTIONAL_TESTS_LOG_LEVEL}"
    FUNCTIONAL_TESTS_CONTAINER_PREFIX = "${env.BUILD_TAG}"
  }

  stages {
    stage('Prepare nightly experiment') {
      when { expression { isNightlyExperiment() } }
      steps { script {
        dir('nightly-report') { deleteDir() }
        sh 'mkdir -p nightly-report'
        writeFile(file: 'nightly-report/issue-report.json',
                  text: '{"action":"not-run","message":"Reporting has not run; see console if credential binding fails."}\n')
        sh 'git rev-parse HEAD > nightly-report/status-go-sha.txt'
        echo 'GITHUB AUTHENTICATION TEST: this run will attempt to create a visible TEST issue in status-im/status-go.'
      } }
    }

    stage('Resolve nightly image') {
      when { expression { isNightlyExperiment() } }
      steps { script {
        env.NIGHTLY_IMAGE = 'quay.io/wakuorg/nwaku-pr:nightly-logosdeliverynode'
        sh 'docker pull "$NIGHTLY_IMAGE"'
        env.WAKU_IMAGE = sh(returnStdout: true,
          script: 'docker image inspect "$NIGHTLY_IMAGE" --format \'{{index .RepoDigests 0}}\'').trim()
        writeFile(file: 'nightly-report/delivery-image.txt', text: "${env.WAKU_IMAGE}\n")
        echo "Testing Logos Delivery image: ${env.WAKU_IMAGE}"
      } }
    }

    stage('RPC Tests') {
      steps { script {
        withCredentials([
          string(
            credentialsId: 'codecov-repository-upload-token',
            variable: 'CODECOV_TOKEN'
          ),
          usernamePassword(
            credentialsId: "api-proxy-devel",
            usernameVariable: 'STATUS_BUILD_PROXY_USER',
            passwordVariable: 'STATUS_BUILD_PROXY_PASSWORD'
    ),
        ]) {
          def overrides = isNightlyExperiment() ? ['FUNCTIONAL_TESTS_REPORT_CODECOV=false'] : []
          withEnv(overrides) {
            nix.develop('make test-functional USE_LOGOS_STORAGE=true', pure: false)
          }
        }
      } }
    }
  } // stages

  post {
    always {
      script {
        try {
          junit(
            testResults: 'test/functional/reports/*.xml',
            skipOldReports: true,
            skipPublishingChecks: true,
            skipMarkingBuildUnstable: true,
          )
        } finally {
          try {
            if (isNightlyExperiment()) {
              stage('GitHub issue reporting') {
                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                  reportNightlyIssues()
                }
              }
            }
          } finally {
            archiveArtifacts(
              artifacts: 'nightly-report/**, test/functional/reports/*.xml, ' +
                         'test/functional/logs/*.log, test/functional/coverage/coverage.html',
              allowEmptyArchive: true,
            )
          }
        }
      }
    }
    success { script { github.notifyPR(true) } }
    failure { script { github.notifyPR(false) } }
    cleanup {
      sh '''
        docker ps -a --filter "name=${FUNCTIONAL_TESTS_CONTAINER_PREFIX}" -q | xargs -r docker rm -f
      '''
      cleanWs()
      dir(env.WORKSPACE_TMP) { deleteDir() }
    }
  } // post
} // pipeline

// Temporary PR experiment: other branches retain the stable image and Codecov setting.
def isNightlyExperiment() {
  def branch = env.CHANGE_BRANCH ?: env.BRANCH_NAME ?: params.BRANCH
  // Some Pipeline jobs expose PR-123 as BRANCH_NAME and the source branch as BRANCH.
  if (branch?.startsWith('PR-')) { branch = params.BRANCH }
  return branch == 'ci/jenkins-logos-delivery-nightly'
}

def reportNightlyIssues() {
  try {
    withEnv(["NIGHTLY_BUILD_RESULT=${currentBuild.currentResult}"]) {
      // Same username/token credential used by github.notify(), the notifyPR fallback,
      // in status-jenkins-lib@v1.9.39 (vars/github.groovy).
      withCredentials([usernamePassword(credentialsId: 'status-im-auto',
        usernameVariable: 'GH_USERNAME', passwordVariable: 'GH_TOKEN')]) {
        sh '''
          set +x
          python3 scripts/report_nightly_issues.py --mode auth-test
        '''
      }
    }
  } finally {
    if (fileExists('nightly-report/issue-url.txt')) {
      def issueUrl = readFile('nightly-report/issue-url.txt').trim()
      currentBuild.description = "GitHub issue: ${issueUrl}"
      echo "GITHUB ISSUE CREATED OR UPDATED: ${issueUrl}"
    } else {
      currentBuild.description = 'GitHub reporting: see nightly-report/issue-report.json artifact and console'
      echo 'No issue URL recorded. See nightly-report/issue-report.json and the reporting stage output.'
    }
  }
}
