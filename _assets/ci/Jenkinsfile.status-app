#!/usr/bin/env groovy
library 'status-jenkins-lib@v1.9.39'

/**
 * status-app companion build.
 */

def isPRBuild = utils.isPRBuild()

pipeline {
  agent {
    docker {
      label 'linuxcontainer'
      image 'harbor.status.im/infra/ci-build-containers:linux-base-1.0.0'
      args '--volume=/nix:/nix --volume=/etc/nix:/etc/nix'
    }
  }

  parameters {
    string(
      name: 'STATUS_APP_BRANCH',
      defaultValue: params.STATUS_APP_BRANCH ?: 'master',
      description: 'Name of the status-app branch to build.'
    )
  }

  options {
    timestamps()
    ansiColor('xterm')
    timeout(time: 240, unit: 'MINUTES')
    disableConcurrentBuilds(abortPrevious: isPRBuild)
    disableRestartFromStage()
    buildDiscarder(logRotator(
      numToKeepStr:          '10',
      daysToKeepStr:         '30',
      artifactNumToKeepStr:  '1',
      artifactDaysToKeepStr: '30',
    ))
  }

  environment {
    /* GIT_COMMIT is the status-go commit being tested. status-app's
     * platform jobs use this to override vendor/status-go. */
    STATUS_GO_REF = "${env.GIT_COMMIT}"
    /* Hack-fix for params not being set in env on first job run. */
    STATUS_APP_BRANCH = "${params.STATUS_APP_BRANCH}"
  }

  stages {
    stage('status-app') {
      parallel {
        stage('Linux/x86_64') {
          stages {
            stage('Package') {
              steps { script {
                linux_x86_64 = build(
                  job:        'status-app/systems/linux/x86_64/package',
                  parameters: jenkins.mapToParams([
                    BRANCH:        env.STATUS_APP_BRANCH,
                    STATUS_GO_REF: env.STATUS_GO_REF,
                  ]),
                  wait:       true,
                  propagate:  true,
                )
              } }
            }
            /* Only reached if the Linux package build above succeeded. */
            stage('E2E') {
              steps { script {
                build(
                  job:        'status-app/systems/linux/x86_64/tests-e2e',
                  parameters: jenkins.mapToParams([
                    BRANCH:          env.STATUS_APP_BRANCH,
                    BUILD_SOURCE:    linux_x86_64.fullProjectName,
                    TEST_SCOPE_FLAG: '-m=critical',
                  ]),
                  wait:       true,
                  propagate:  true,
                )
              } }
            }
          }
        }
        stage('Windows/x86_64') {
          stages {
            stage('Package') {
              steps { script {
                windows_x86_64 = build(
                  job:        'status-app/systems/windows/x86_64/package',
                  parameters: jenkins.mapToParams([
                    BRANCH:        env.STATUS_APP_BRANCH,
                    STATUS_GO_REF: env.STATUS_GO_REF,
                  ]),
                  wait:       true,
                  propagate:  true,
                )
              } }
            }
            /* Only reached if the Windows package build above succeeded. */
            stage('E2E') {
              steps { script {
                build(
                  job:        'status-app/systems/windows/x86_64/tests-e2e',
                  parameters: jenkins.mapToParams([
                    BRANCH:          env.STATUS_APP_BRANCH,
                    BUILD_SOURCE:    windows_x86_64.fullProjectName,
                    TEST_SCOPE_FLAG: '-m=critical',
                  ]),
                  wait:       true,
                  propagate:  true,
                )
              } }
            }
          }
        }
        stage('MacOS/aarch64') {
          steps { script {
            build(
              job:        'status-app/systems/macos/aarch64/package',
              parameters: jenkins.mapToParams([
                BRANCH:        env.STATUS_APP_BRANCH,
                STATUS_GO_REF: env.STATUS_GO_REF,
              ]),
              wait:       true,
              propagate:  true,
            )
          } }
        }
        stage('iOS/aarch64') {
          steps { script {
            build(
              job:        'status-app/systems/ios/aarch64/package',
              parameters: jenkins.mapToParams([
                BRANCH:        env.STATUS_APP_BRANCH,
                STATUS_GO_REF: env.STATUS_GO_REF,
              ]),
              wait:       true,
              propagate:  true,
            )
          } }
        }
        stage('Android/arm64') {
          steps { script {
            build(
              job:        'status-app/systems/android/arm64/package',
              parameters: jenkins.mapToParams([
                BRANCH:        env.STATUS_APP_BRANCH,
                STATUS_GO_REF: env.STATUS_GO_REF,
              ]),
              wait:       true,
              propagate:  true,
            )
          } }
        }
      }
    }
  }

  post {
    success { script { github.notifyPR(true)  } }
    failure { script { github.notifyPR(false) } }
    cleanup {
      cleanWs()
      dir(env.WORKSPACE_TMP) { deleteDir() }
    }
  }
}
