# Example environment variables for Sepolia test backends
# Copy this file to .env and fill in actual Sepolia addresses/keys

# Shared password for Sepolia test accounts
SEPOLIA_TEST_PASSWORD=YourStrongPasswordHere123!@#

# Owner backend Sepolia account (must have ETH for gas)
SEPOLIA_OWNER_ADDRESS=0xYourSepoliaOwnerAddress
SEPOLIA_OWNER_PRIVATE_KEY=YourSepoliaOwnerPrivateKey
SEPOLIA_OWNER_MNEMONIC=your sepolia owner mnemonic here

# Member backend Sepolia account (must have ETH for gas)
SEPOLIA_MEMBER_ADDRESS=0xYourSepoliaMemberAddress
SEPOLIA_MEMBER_PRIVATE_KEY=YourSepoliaMemberPrivateKey
SEPOLIA_MEMBER_MNEMONIC=your sepolia member mnemonic here

# RPC Key for Sepolia (replace with actual Infura project ID)
STATUS_BUILD_INFURA_TOKEN=project_id

# Example environment variables for Arbitrum test backends
# Copy this file to .env and fill in actual Arbitrum addresses/keys

# Shared password for Arbitrum test accounts
ARBITRUM_TEST_PASSWORD=YourStrongPasswordHere123!@#

# Owner backend Arbitrum account (must have ETH for gas)
ARBITRUM_OWNER_ADDRESS=0xYourArbitrumOwnerAddress
ARBITRUM_OWNER_PRIVATE_KEY=YourArbitrumOwnerPrivateKey
ARBITRUM_OWNER_MNEMONIC=your arbitrum owner mnemonic here

# Member backend Arbitrum account (must have ETH for gas)
ARBITRUM_MEMBER_ADDRESS=0xYourArbitrumMemberAddress
ARBITRUM_MEMBER_PRIVATE_KEY=YourArbitrumMemberPrivateKey
ARBITRUM_MEMBER_MNEMONIC=your arbitrum member mnemonic here
